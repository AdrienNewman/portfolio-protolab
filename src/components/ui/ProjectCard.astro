---
/**
 * ProjectCard - Badge style compact (like SkillCard)
 * V2: No border, subtle glow hover, modal trigger on click
 */
interface Props {
    id: string;
    title: string;
    icon: string;
    iconColor?: string;
}

const { id, title, icon, iconColor = 'cyan' } = Astro.props;

// Map color names to CSS variables
const colorMap: Record<string, string> = {
    cyan: 'var(--neon-cyan)',
    magenta: 'var(--neon-magenta)',
    green: 'var(--neon-green)',
    purple: '#a855f7',
    blue: '#3b82f6'
};

const glowColor = colorMap[iconColor] || colorMap.cyan;
---

<div class="project-card" data-project={id} style={`--glow-color: ${glowColor}`}>
    <div class="project-icon">
        <svg viewBox="0 0 24 24" set:html={icon} />
    </div>
    <h3 class="project-title">{title}</h3>
</div>

<style>
    .project-card {
        background: transparent;
        border: none;
        padding: 1rem 0.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        cursor: pointer;
        opacity: 0;
        transform: translateY(20px);
    }

    .project-card:hover {
        transform: translateY(-3px);
        filter: drop-shadow(0 8px 25px color-mix(in srgb, var(--glow-color) 25%, transparent));
    }

    .project-card:hover .project-icon svg {
        filter: brightness(1.15) drop-shadow(0 0 8px var(--glow-color));
    }

    .project-card:hover .project-title {
        color: var(--glow-color);
    }

    .project-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
    }

    .project-icon svg {
        width: 48px;
        height: 48px;
        stroke: var(--glow-color);
        stroke-width: 1.5;
        fill: none;
        transition: all 0.3s ease;
    }

    .project-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 0.9rem;
        letter-spacing: 0.08em;
        text-align: center;
        margin: 0;
        color: var(--gray-light);
        text-transform: uppercase;
        transition: color 0.3s ease;
    }

    @media (max-width: 768px) {
        .project-icon {
            width: 48px;
            height: 48px;
        }
        .project-icon svg {
            width: 36px;
            height: 36px;
        }
        .project-title {
            font-size: 0.75rem;
        }
    }

    @media (max-width: 480px) {
        .project-card {
            padding: 0.75rem 0.25rem;
        }
        .project-icon {
            width: 40px;
            height: 40px;
            margin-bottom: 0.5rem;
        }
        .project-icon svg {
            width: 28px;
            height: 28px;
        }
        .project-title {
            font-size: 0.65rem;
        }
    }
</style>
